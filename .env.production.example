# Production template only. Never commit the populated file or place real
# credentials in this template. Supply the values through a secret manager or
# a file kept outside the repository when running Compose.

# PostgreSQL connection string. Use TLS and a least-privileged application user.
DATABASE_URL="postgresql://APP_USER:REPLACE_PASSWORD@DB_HOST:5432/DB_NAME?schema=public&sslmode=require"

# Generate independently, for example: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"
RATE_LIMIT_SALT="replace-with-another-random-secret"

# Public origin used by backend CORS and origin checks.
FRONTEND_URL="https://example.invalid"

# Set to the known proxy hop count (1-10) or an explicit comma-separated
# IP/CIDR allowlist. Keep false when the backend receives client traffic directly.
TRUST_PROXY="false"

# Optional host port for the local reverse proxy or load balancer.
FRONTEND_PORT="3000"
